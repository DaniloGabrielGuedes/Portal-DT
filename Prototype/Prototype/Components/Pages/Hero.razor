@page "/"
@using Prototype.Components.Global
@using Prototype.Components.Layout.HeroPage

<Prototype.Components.Metadata.HeroSeo />

<SectionInicio />

<section id="prefacio" class="relative py-24 bg-slate-950 overflow-hidden">
    
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-20"></div>
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-red-600/5 rounded-full blur-3xl"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center mb-16">
            <div class="inline-block mb-4">
                <span class="px-4 py-2 rounded-full bg-red-500/10 border border-red-400/30 text-red-300 text-sm font-semibold">
                    A Dor
                </span>
            </div>
            <h2 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
                Seu sistema de gestão é robusto.
                <span class="block mt-2 bg-gradient-to-r from-red-400 via-orange-400 to-red-500 bg-clip-text text-transparent">
                    Mas ele é rápido?
                </span>
            </h2>
            <p class="text-lg sm:text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
                Os maiores ERPs do mercado garantem segurança, mas frequentemente custam a agilidade da sua operação. 
                Telas complexas, cliques excessivos e travas desnecessárias estão <span class="text-red-400 font-semibold">matando sua produtividade</span>.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            
            <div class="group p-8 rounded-2xl bg-gradient-to-br from-slate-900/80 to-slate-950/80 backdrop-blur-md border border-red-500/10 hover:border-red-500/30 transition-all duration-300 hover:scale-105 hover:shadow-xl hover:shadow-red-900/20">
                <div class="w-14 h-14 rounded-xl bg-red-900/20 flex items-center justify-center mb-6 group-hover:bg-red-900/30 transition-colors">
                     <svg class="w-8 h-8 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">O Problema</h3>
                <p class="text-gray-400 leading-relaxed">
                    Interfaces datadas e complexas.
                </p>
            </div>

            <div class="group p-8 rounded-2xl bg-gradient-to-br from-slate-900/80 to-slate-950/80 backdrop-blur-md border border-orange-500/10 hover:border-orange-500/30 transition-all duration-300 hover:scale-105 hover:shadow-xl hover:shadow-orange-900/20">
                <div class="w-14 h-14 rounded-xl bg-orange-900/20 flex items-center justify-center mb-6 group-hover:bg-orange-900/30 transition-colors">
                    <svg class="w-8 h-8 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                         <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">O Gargalo</h3>
                <p class="text-gray-400 leading-relaxed">
                    Processos que exigem 10 cliques quando poderiam levar 1.
                </p>
            </div>

            <div class="group p-8 rounded-2xl bg-gradient-to-br from-blue-900/20 to-slate-900/80 backdrop-blur-md border border-blue-500/20 hover:border-blue-500/40 transition-all duration-300 hover:scale-105 hover:shadow-xl hover:shadow-blue-900/20">
                <div class="w-14 h-14 rounded-xl bg-blue-900/20 flex items-center justify-center mb-6 group-hover:bg-blue-900/30 transition-colors">
                     <svg class="w-8 h-8 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">A Solução</h3>
                <p class="text-gray-400 leading-relaxed">
                    Uma camada de inteligência ágil que flutua sobre seu banco de dados.
                </p>
            </div>

        </div>
    </div>
</section>

