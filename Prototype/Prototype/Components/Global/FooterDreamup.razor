@using Microsoft.AspNetCore.Components.Web
@using Prototype.Components.Global
@rendermode InteractiveServer

<footer id="contato" class="relative bg-slate-950 overflow-hidden">

    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-20"></div>

    <!-- Formulário de Contato -->
    <div class="relative border-b border-white/5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">

                <!-- Lado Esquerdo: Texto + WhatsApp -->
                <div class="space-y-8">
                    <div>
                        <div class="inline-block mb-4">
                            <span class="px-4 py-2 rounded-full bg-blue-500/10 border border-blue-400/30 text-blue-300 text-sm font-semibold">
                                Fale Conosco
                            </span>
                        </div>
                        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4 leading-tight">
                            Conte-nos sobre o seu
                            <span class="bg-gradient-to-r from-blue-400 to-sky-500 bg-clip-text text-transparent">desafio.</span>
                        </h2>
                        <p class="text-gray-400 leading-relaxed">
                            Preencha o formulário ao lado e um dos nossos especialistas entrará em contato em até 2 horas úteis.
                            Ou, se preferir, fale agora mesmo pelo WhatsApp.
                        </p>
                    </div>

                    <!-- WhatsApp Card -->
                    <a href="https://wa.me/5511999999999?text=Olá! Gostaria de falar com um especialista da Daup." target="_blank" rel="noopener noreferrer"
                       class="group flex items-center gap-4 p-6 rounded-2xl bg-gradient-to-br from-green-900/20 to-slate-950/60 backdrop-blur-md border border-green-500/15 hover:border-green-400/40 transition-all duration-500 hover:shadow-2xl hover:shadow-green-600/10">
                        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-green-600/30 to-green-800/20 flex items-center justify-center border border-green-500/20 group-hover:from-green-600/40 transition-all duration-300">
                            <svg class="w-7 h-7 text-green-400" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
                            </svg>
                        </div>
                        <div class="flex-1">
                            <div class="text-white font-semibold mb-1">Prefere WhatsApp?</div>
                            <div class="text-sm text-gray-400 group-hover:text-green-300/70 transition-colors">Clique aqui e fale agora com um especialista</div>
                        </div>
                        <svg class="w-5 h-5 text-green-400/50 group-hover:text-green-400 group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                        </svg>
                    </a>

                    <!-- Info de Confiança -->
                    <div class="grid grid-cols-2 gap-4">
                        <div class="flex items-center gap-3 p-4 rounded-xl bg-white/5 border border-white/5">
                            <div class="w-10 h-10 rounded-lg bg-blue-600/20 flex items-center justify-center">
                                <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                                </svg>
                            </div>
                            <div>
                                <div class="text-white text-sm font-medium">100% Seguro</div>
                                <div class="text-xs text-gray-500">Dados protegidos</div>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 p-4 rounded-xl bg-white/5 border border-white/5">
                            <div class="w-10 h-10 rounded-lg bg-blue-600/20 flex items-center justify-center">
                                <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                            <div>
                                <div class="text-white text-sm font-medium">Resposta Rápida</div>
                                <div class="text-xs text-gray-500">Até 2h úteis</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Lado Direito: Formulário -->
                <div class="relative">
                    <div class="absolute -inset-1 bg-gradient-to-r from-blue-600/20 to-sky-500/20 rounded-2xl blur opacity-30"></div>

                    <div class="relative p-8 rounded-2xl bg-gradient-to-br from-slate-900/90 to-slate-950/90 backdrop-blur-xl border border-blue-400/20 shadow-2xl">

                        @if (FormEnviado)
                        {
                            <div class="text-center py-8">
                                <div class="w-16 h-16 rounded-full bg-green-500/20 flex items-center justify-center mx-auto mb-4">
                                    <svg class="w-8 h-8 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </div>
                                <h3 class="text-xl font-bold text-white mb-2">Mensagem Enviada!</h3>
                                <p class="text-gray-400">Entraremos em contato em breve. Obrigado!</p>
                            </div>
                        }
                        else
                        {
                            <h3 class="text-xl font-bold text-white mb-6">Formulário de Contato</h3>

                            <EditForm Model="ContatoModel" OnValidSubmit="EnviarFormulario" FormName="contato-form">
                                <div class="space-y-4">

                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                        <div>
                                            <label class="block text-sm text-gray-400 mb-1.5">Nome *</label>
                                            <InputText @bind-Value="ContatoModel.Nome"
                                                       class="w-full px-4 py-3 rounded-lg bg-white/5 border border-white/10 text-white text-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500 transition-colors"
                                                       placeholder="Seu nome completo" />
                                        </div>
                                        <div>
                                            <label class="block text-sm text-gray-400 mb-1.5">E-mail *</label>
                                            <InputText @bind-Value="ContatoModel.Email"
                                                       class="w-full px-4 py-3 rounded-lg bg-white/5 border border-white/10 text-white text-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500 transition-colors"
                                                       placeholder="seu@email.com" />
                                        </div>
                                    </div>

                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                        <div>
                                            <label class="block text-sm text-gray-400 mb-1.5">Telefone</label>
                                            <InputText @bind-Value="ContatoModel.Telefone"
                                                       class="w-full px-4 py-3 rounded-lg bg-white/5 border border-white/10 text-white text-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500 transition-colors"
                                                       placeholder="(11) 99999-9999" />
                                        </div>
                                        <div>
                                            <label class="block text-sm text-gray-400 mb-1.5">Empresa</label>
                                            <InputText @bind-Value="ContatoModel.Empresa"
                                                       class="w-full px-4 py-3 rounded-lg bg-white/5 border border-white/10 text-white text-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500 transition-colors"
                                                       placeholder="Nome da empresa" />
                                        </div>
                                    </div>

                                    <div>
                                        <label class="block text-sm text-gray-400 mb-1.5">Mensagem *</label>
                                        <InputTextArea @bind-Value="ContatoModel.Mensagem"
                                                       class="w-full px-4 py-3 rounded-lg bg-white/5 border border-white/10 text-white text-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500 transition-colors resize"
                                                       rows="4"
                                                       placeholder="Conte-nos brevemente sobre seu desafio ou necessidade..." />
                                    </div>

                                    <button type="submit"
                                            class="group relative w-full px-6 py-4 bg-gradient-to-r from-blue-600 to-blue-700 text-white font-semibold rounded-lg overflow-hidden transition-all duration-300 hover:shadow-2xl hover:shadow-blue-600/30">
                                        <span class="relative z-10 flex items-center justify-center gap-2">
                                            Enviar Mensagem
                                            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                                            </svg>
                                        </span>
                                        <div class="absolute inset-0 bg-gradient-to-r from-blue-700 to-sky-600 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                                    </button>

                                </div>
                            </EditForm>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Links do Footer -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="py-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">

            <div class="space-y-4">
                <Logo />
                <p class="text-sm text-gray-400 leading-relaxed">
                    Soluções corporativas de integração e extensibilidade para sistemas de gestão empresarial.
                </p>
                <div class="flex gap-3 pt-2">
                    <a href="#" class="w-9 h-9 rounded-lg bg-white/5 hover:bg-blue-600/20 border border-white/10 hover:border-blue-400/50 flex items-center justify-center text-gray-400 hover:text-blue-400 transition-all duration-300">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"></path>
                        </svg>
                    </a>
                    <a href="#" class="w-9 h-9 rounded-lg bg-white/5 hover:bg-blue-600/20 border border-white/10 hover:border-blue-400/50 flex items-center justify-center text-gray-400 hover:text-blue-400 transition-all duration-300">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
                        </svg>
                    </a>
                    <a href="#" class="w-9 h-9 rounded-lg bg-white/5 hover:bg-blue-600/20 border border-white/10 hover:border-blue-400/50 flex items-center justify-center text-gray-400 hover:text-blue-400 transition-all duration-300">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
                        </svg>
                    </a>
                </div>
            </div>

            <div>
                <h3 class="text-white font-semibold mb-4">Soluções</h3>
                <ul class="space-y-2.5">
                    <li><a href="#" class="text-sm text-gray-400 hover:text-blue-400 transition-colors">Integrações ERP</a></li>
                    <li><a href="#" class="text-sm text-gray-400 hover:text-blue-400 transition-colors">APIs Corporativas</a></li>
                    <li><a href="#" class="text-sm text-gray-400 hover:text-blue-400 transition-colors">Automação de Processos</a></li>
                    <li><a href="#" class="text-sm text-gray-400 hover:text-blue-400 transition-colors">Consultoria Técnica</a></li>
                </ul>
            </div>

            <div>
                <h3 class="text-white font-semibold mb-4">Empresa</h3>
                <ul class="space-y-2.5">
                    <li><a href="#" class="text-sm text-gray-400 hover:text-blue-400 transition-colors">Sobre Nós</a></li>
                    <li><a href="#" class="text-sm text-gray-400 hover:text-blue-400 transition-colors">Cases de Sucesso</a></li>
                    <li><a href="#" class="text-sm text-gray-400 hover:text-blue-400 transition-colors">Blog</a></li>
                    <li><a href="#" class="text-sm text-gray-400 hover:text-blue-400 transition-colors">Carreiras</a></li>
                </ul>
            </div>

            <div>
                <h3 class="text-white font-semibold mb-4">Contato</h3>
                <ul class="space-y-3">
                    <li class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-blue-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                        </svg>
                        <span class="text-sm text-gray-400">contato@enterprise.com.br</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-blue-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                        </svg>
                        <span class="text-sm text-gray-400">+55 (11) 9999-9999</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-blue-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        <span class="text-sm text-gray-400">São Paulo, SP - Brasil</span>
                    </li>
                </ul>
            </div>

        </div>

        <!-- Copyright -->
        <div class="py-6 border-t border-white/5">
            <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                <p class="text-sm text-gray-500">
                    &copy; 2026 Daup Technology. Todos os direitos reservados.
                </p>
                <div class="flex gap-6">
                    <a href="#" class="text-sm text-gray-500 hover:text-blue-400 transition-colors">Privacidade</a>
                    <a href="#" class="text-sm text-gray-500 hover:text-blue-400 transition-colors">Termos de Uso</a>
                    <a href="#" class="text-sm text-gray-500 hover:text-blue-400 transition-colors">Cookies</a>
                </div>
            </div>
        </div>

    </div>
</footer>

@code {

    private ContatoFormModel ContatoModel { get; set; } = new();
    private bool FormEnviado { get; set; } = false;

    private async Task EnviarFormulario()
    {
        // TODO: Implementar envio real (e-mail, banco, etc.)
        await Task.Delay(500);
        FormEnviado = true;
        StateHasChanged();
    }

    public class ContatoFormModel
    {
        public string Nome { get; set; } = "";
        public string Email { get; set; } = "";
        public string Telefone { get; set; } = "";
        public string Empresa { get; set; } = "";
        public string Mensagem { get; set; } = "";
    }
}