@using Microsoft.AspNetCore.Components.Web
@using Prototype.Components.Global
@rendermode InteractiveServer

<nav class="fixed top-0 left-0 w-full z-50 bg-slate-900/80 backdrop-blur-md border-b border-white/10 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
            
            <Logo />
            
            <div class="hidden md:block">
                <div class="ml-10 flex items-baseline space-x-8">
                    <a href="#inicio" class="text-white hover:text-blue-400 px-3 py-2 rounded-md text-sm font-medium transition-colors relative group">
                        Início
                        <span class="absolute bottom-0 left-0 w-full h-0.5 bg-blue-400 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></span>
                    </a>
                    
                    <a href="#solucoes" class="text-gray-300 hover:text-white px-3 py-2 rounded-md text-sm font-medium transition-colors relative group">
                        Soluções
                        <span class="absolute bottom-0 left-0 w-full h-0.5 bg-blue-400 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></span>
                    </a>
                    
                    <a href="#sobre-nos" class="text-gray-300 hover:text-white px-3 py-2 rounded-md text-sm font-medium transition-colors relative group">
                        Sobre Nós
                        <span class="absolute bottom-0 left-0 w-full h-0.5 bg-blue-400 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></span>
                    </a>
                    
                    <a href="#solucoes" class="text-gray-300 hover:text-white px-3 py-2 rounded-md text-sm font-medium transition-colors relative group">
                        Cases
                        <span class="absolute bottom-0 left-0 w-full h-0.5 bg-blue-400 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></span>
                    </a>
                </div>
            </div>
            
            <div class="hidden md:block">
                <a href="#contato" class="px-5 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold transition-all shadow-lg shadow-blue-600/20 hover:shadow-blue-600/40 hover:-translate-y-0.5 border border-transparent hover:border-blue-400/50">
                    Fale Conosco
                </a>
            </div>
            
            <div class="-mr-2 flex md:hidden">
                <button type="button" @onclick="ToggleMenu" class="inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-white hover:bg-white/10 focus:outline-none transition-colors" aria-controls="mobile-menu" aria-expanded="@isMenuOpen">
                    <span class="sr-only">Abrir menu principal</span>
                    @if (!isMenuOpen)
                    {
                        <svg class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    }
                    else
                    {
                        <svg class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    }
                </button>
            </div>
        </div>
    </div>

    <div class="@(isMenuOpen ? "block" : "hidden") md:hidden bg-slate-900/95 backdrop-blur-xl border-t border-white/10 absolute w-full left-0 top-20 transition-all duration-300 ease-in-out origin-top shadow-2xl" id="mobile-menu">
        <div class="px-4 pt-4 pb-6 space-y-2">
            <a href="#inicio" @onclick="ToggleMenu" class="text-white hover:bg-white/10 hover:text-blue-400 block px-4 py-3 rounded-lg text-base font-medium transition-colors border-l-2 border-blue-500 bg-white/5">Início</a>
            <a href="#solucoes" @onclick="ToggleMenu" class="text-gray-300 hover:bg-white/10 hover:text-white block px-4 py-3 rounded-lg text-base font-medium transition-colors border-l-2 border-transparent hover:border-blue-400">Soluções</a>
            <a href="#sobre-nos" @onclick="ToggleMenu" class="text-gray-300 hover:bg-white/10 hover:text-white block px-4 py-3 rounded-lg text-base font-medium transition-colors border-l-2 border-transparent hover:border-blue-400">Sobre Nós</a>
            <a href="#solucoes" @onclick="ToggleMenu" class="text-gray-300 hover:bg-white/10 hover:text-white block px-4 py-3 rounded-lg text-base font-medium transition-colors border-l-2 border-transparent hover:border-blue-400">Cases</a>
            <div class="pt-4 mt-4 border-t border-white/10">
                <a href="#contato" @onclick="ToggleMenu" class="w-full flex items-center justify-center px-4 py-3 border border-transparent rounded-lg shadow-sm text-base font-medium text-white bg-blue-600 hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-600/30 transition-all">
                    Fale Conosco
                </a>
            </div>
        </div>
    </div>
</nav>

@code {
    private bool isMenuOpen = false;

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }
}
