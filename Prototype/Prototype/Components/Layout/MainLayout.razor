@inherits LayoutComponentBase

<div class="min-h-screen flex flex-col bg-slate-900 text-white font-sans selection:bg-blue-500 selection:text-white">
    <Navbar />

    <main class="flex-grow pt-20">
        @Body
    </main>
</div>

<div id="blazor-error-ui" class="hidden fixed bottom-0 left-0 w-full bg-yellow-100 text-yellow-900 border-t border-yellow-200 p-4 z-50 text-center items-center justify-between" data-nosnippet>
    <span>An unhandled error has occurred.</span>
    <div>
        <a href="" class="reload underline font-bold ml-4 text-yellow-800 hover:text-yellow-950">Reload</a>
        <a class="dismiss cursor-pointer font-bold ml-4 text-yellow-800 hover:text-yellow-950">🗙</a>
    </div>
</div>
