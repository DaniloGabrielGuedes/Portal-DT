<script>
    const phrases = [
        "Soluções totalmente personalizadas para a sua empresa.",
        "Criação de CRMs de acordo com a sua necessidade.",
        "Integre dados em tempo real com o seu ERP.",
        "Automatize processos. Aumente performance. Reduza burocracias.",
        "Tecnologia sob medida para escalar seu negócio."
    ];

    const heroTitle = document.getElementById("hero-title");

    let index = 0;

    function changePhrase() {
        heroTitle.classList.remove("opacity-100");
        heroTitle.classList.add("opacity-0");

        setTimeout(() => {
            index = (index + 1) % phrases.length;
            heroTitle.textContent = phrases[index];

            heroTitle.classList.remove("opacity-0");
            heroTitle.classList.add("opacity-100");
        }, 500);
    }

    setInterval(changePhrase, 8000);
</script>
