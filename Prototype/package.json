{
  "name": "prototype",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "css:build": "tailwindcss -i ./Prototype/Prototype/Styles/app.css -o ./Prototype/Prototype/wwwroot/css/app.css --minify",
    "css:watch": "tailwindcss -i ./Prototype/Prototype/Styles/app.css -o ./Prototype/Prototype/wwwroot/css/app.css --watch",
    "copy:preline": "node -e \"require('fs').copyFileSync('./node_modules/preline/dist/preline.js', './Prototype/Prototype/wwwroot/js/preline.js')\"",
    "build": "npm run css:build && npm run copy:preline",
    "dev": "npm run copy:preline && npm run css:watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "preline": "^2.7.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
